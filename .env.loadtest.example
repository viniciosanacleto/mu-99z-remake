# Load test only (docker-compose.loadtest.yml). Copy to .env.loadtest; the
# production .env is not read when --env-file .env.loadtest is given.

# The bots run on this machine.
MU_PUBLIC_IP=127.0.0.1
MU_BLACKLIST=none
MU_INSTANCES=gameserver,gameserver-cs
MU_DEBUG=

# pprof and /debug/load. Keep it on a test machine: it has no authentication.
MU_METRICS_ADDR=:6060
MU_METRICS_HOST_PORT=6060

# Creates the load0001.. accounts (password "load") with one character each.
MU_SEED_LOAD=100

# 0 lifts MaxConnectionPerIP: with Docker Desktop every bot arrives from the
# Docker gateway address.
MU_MAX_CONN_PER_IP=0

# ServerMaxUserNumber of every GameServer (0 = configured, 100). Raise it for
# steps above 100 players.
MU_MAX_USERS=0

# Separate database port so it does not clash with a running deploy.
POSTGRES_USER=mu
POSTGRES_PASSWORD=mu
POSTGRES_DB=mu
POSTGRES_HOST_PORT=55433
