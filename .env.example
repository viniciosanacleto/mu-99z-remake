# Copy to .env and adjust before `docker compose up`.

# Host LAN IP sent to the client for the GameServers (same IP as License.wzt).
MU_PUBLIC_IP=192.168.18.5

# Client addresses the ConnectServer refuses, comma-separated; "none" for an
# empty list; empty keeps the BlackList of config/server.toml.
MU_BLACKLIST=none

# GameServer instances (files in config/gameserver, without .toml).
MU_INSTANCES=gameserver,gameserver-cs

# Any value enables debug logging.
MU_DEBUG=

# Load test (docs/server-plan/18-teste-de-carga.md). MU_METRICS_ADDR=:6060
# serves pprof and /debug/load (do not expose it on a public server);
# MU_SEED_LOAD creates that many load0001.. accounts; MU_MAX_CONN_PER_IP=0
# lifts the per-IP limits (every bot comes from the Docker gateway address);
# MU_MAX_USERS raises ServerMaxUserNumber (empty = configured).
MU_METRICS_ADDR=
MU_METRICS_HOST_PORT=6060
MU_SEED_LOAD=
MU_MAX_CONN_PER_IP=
MU_MAX_USERS=

POSTGRES_USER=mu
POSTGRES_PASSWORD=mu
POSTGRES_DB=mu
POSTGRES_HOST_PORT=55432
